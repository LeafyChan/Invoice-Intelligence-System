{
  "_comment": "Edit this file to change what gets extracted/validated from Purchase Orders. No code changes needed. Field names deliberately mirror invoice_schema.json where the concept overlaps (vendor_gstin, taxable_amount, etc.) so reconciliation code can compare PO fields against invoice fields directly.",
  "required_fields": [
    "po_number",
    "po_date",
    "vendor_name",
    "total_amount"
  ],
  "optional_fields": [
    "vendor_gstin",
    "place_of_supply",
    "delivery_date",
    "delivery_date_requested",
    "taxable_amount",
    "cgst_amount",
    "sgst_amount",
    "igst_amount",
    "total_gst_amount",
    "line_items",
    "notes_raw",
    "incoterm_raw",
    "incoterm",
    "incoterm_named_place",
    "payment_terms",
    "advance_payment_percent",
    "requested_transport_mode"
  ],
  "field_types": {
    "po_number": "string",
    "po_date": "date",
    "vendor_name": "string",
    "vendor_gstin": "gstin",
    "place_of_supply": "string",
    "delivery_date": "string",
    "delivery_date_requested": "string",
    "taxable_amount": "amount",
    "cgst_amount": "amount",
    "sgst_amount": "amount",
    "igst_amount": "amount",
    "total_gst_amount": "amount",
    "total_amount": "amount",
    "line_items": "list",
    "notes_raw": "string",
    "incoterm_raw": "string",
    "incoterm": "string",
    "incoterm_named_place": "string",
    "payment_terms": "string",
    "advance_payment_percent": "amount",
    "requested_transport_mode": "string"
  },
  "validation_rules": {
    "gstin_regex": "^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}$",
    "amount_reconciliation_tolerance": 2.0,
    "max_invoice_age_days": 1825,
    "date_formats": ["%d/%m/%Y", "%d-%m-%Y", "%Y-%m-%d", "%d %b %Y", "%d-%b-%Y", "%d.%m.%Y"],
    "expected_currency": "INR",
    "recognized_currency_codes": ["INR", "RS", "RS.", "₹", "USD", "$", "EUR", "€", "GBP", "£"]
  },
  "confidence_thresholds": {
    "ocr_text_min_confidence": 65,
    "auto_pass_min_confidence": 85,
    "needs_review_below": 70
  },
  "invoice_type_hints": {
    "_comment": "Kept for structural parity with invoice_schema.json / validator.py, which reads this key unconditionally. Not meaningfully used for POs yet.",
    "default": {
      "skip_fields": []
    }
  }
}