    "mrn_number", "mrn_date",
    "grn_number", "po_number",
    "vendor_name", "vendor_gstin",
    "return_reason", "return_initiated_by",
    "line_items"
  ],
  "optional_fields": [
    "total_quantity_returned"
  ],
  "line_item_fields": [
